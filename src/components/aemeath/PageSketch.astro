---
/**
 * 首页留白处的线条勾画。
 *
 * 头像的线稿挂在页面右侧的留白带里，随内容缓慢下移（视差），
 * 只在宽屏出现——窄屏那圈留白会被内容吃掉，图会压到卡片上。
 *
 * 纯装饰：aria-hidden + pointer-events-none，且跟随动效档位（reduced 时不动）。
 */
import avatarTrace from '@/assets/aemeath/avatar-trace.svg?url';
---

<div class="page-sketch" aria-hidden="true">
  <img src={avatarTrace} alt="" width="132" height="132" loading="lazy" decoding="async" />
</div>

<style>
  /*
    宽屏：落在头图与正文之间的过渡留白里，贴右侧、压在波浪线下方那片干净的粉白上。
    滚动时随 fixed 层停住，不跟正文滚。
    右缘再让出 3.25rem：那是右下浮动按钮（音乐/设置/回到顶部）的宽度，压上去会读成两层 UI。

    手机（< 1280px）：没有那圈侧边留白，fixed 层会直接盖在正文上，所以改成
    文档流里的装饰行，夹在头图与正文之间——那里本来就是留白，也不会挡任何东西。
    见下方 `.page-sketch` 的默认（静态）规则。
  */
  .page-sketch {
    /* 手机默认：文档流内的装饰行，头图之后、正文之前。 */
    display: flex;
    justify-content: center;
    width: 100%;
    /* 上下各留一点气口就够：这块本来就在头图与列表之间，留太多会读成空档。 */
    padding-block: 0.25rem;
    /* 往回收一点，别把「文章列表」标题推得太远。 */
    margin-block: -0.75rem -0.25rem;
    pointer-events: none;
    color: hsl(var(--primary) / 0.42);
    opacity: 0;
    animation: page-sketch-in 1s var(--ease-out-quart) 700ms forwards;
  }

  .page-sketch img {
    display: block;
    /* 手机上别太大：这是留白处的点缀，不该抢正文的注意力。 */
    width: 4.75rem;
    height: auto;
    /* 线条本身很细，靠同色描边把它压实成可辨的钩线。 */
    filter:
      drop-shadow(0 0 0.4px currentColor)
      drop-shadow(0 0 0.4px currentColor);
  }

  @keyframes page-sketch-in {
    to {
      opacity: 1;
    }
  }

  /* 宽屏：变成固定层，挂到右侧留白里。 */
  @media (width >= 1280px) {
    .page-sketch {
      position: fixed;
      z-index: 1;
      top: calc(60svh + 1.5rem);
      right: max(3.25rem, calc((100vw - 64rem) / 2 - 8.5rem));
      width: 7rem;
      padding-block: 0;
      display: block;
    }

    .page-sketch img {
      width: 100%;
    }
  }

  /* 视差：内容往前走，线稿慢半拍，读起来像挂在墙上而不是贴在屏幕上。 */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: scroll()) {
      .page-sketch {
        animation:
          page-sketch-in 1s var(--ease-out-quart) 900ms forwards,
          page-sketch-drift linear both;
        animation-timeline: auto, scroll(root block);
        animation-range: normal, 0 100vh;
      }
    }
  }

  @keyframes page-sketch-drift {
    to {
      translate: 0 6rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .page-sketch {
      animation: none;
      opacity: 1;
    }
  }

  @media print {
    .page-sketch {
      display: none;
    }
  }
</style>
