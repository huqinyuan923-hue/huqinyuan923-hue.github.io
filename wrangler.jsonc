{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "huqinyuan923-hue-github-io",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-29",
  "ai": {
    "binding": "AI"
  },
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "SITE_URL": "https://adcakeyuan.top",
    "EMBED_MODEL": "@cf/baai/bge-small-zh-v1.5",
    "QA_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast"
  }
}
