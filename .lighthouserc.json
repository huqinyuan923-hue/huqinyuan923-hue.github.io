{
  "ci": {
    "collect": {
      "staticDistDir": "./out",
      "url": ["/index.html", "/blog.html", "/about.html", "/friends.html"],
      "numberOfRuns": 3,
      "settings": {
        "formFactor": "mobile",
        "screenEmulation": {
          "mobile": true,
          "width": 412,
          "height": 823,
          "devicePixelRatio": 1.75,
          "disabled": false
        },
        "throttlingMethod": "simulate"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.78, "aggregationMethod": "median" }],
        "cumulative-layout-shift": [
          "error",
          { "maxNumericValue": 0.05, "aggregationMethod": "median" }
        ],
        "largest-contentful-paint": [
          "warn",
          { "maxNumericValue": 4200, "aggregationMethod": "median" }
        ],
        "first-contentful-paint": [
          "warn",
          { "maxNumericValue": 1600, "aggregationMethod": "median" }
        ],
        "total-blocking-time": ["warn", { "maxNumericValue": 300, "aggregationMethod": "median" }],
        "unused-javascript": ["warn", { "maxNumericValue": 60000 }],
        "render-blocking-resources": ["warn", { "maxNumericValue": 500 }],
        "total-byte-weight": ["warn", { "maxNumericValue": 1400000 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
